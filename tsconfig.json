{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.AsyncIterable"],
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
